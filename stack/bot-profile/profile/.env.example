# Profile env template — NAMES ONLY.
#
# A template commits the shape of a secret, never the secret. Copy to `.env` in the profile home
# (chmod 600), or materialise the values from a secret manager at start time.
#
#   install -m 600 profile/.env.example ~/.hermes/profiles/{{PROFILE}}/.env
#
# Do not paste a value into this file, into a card, into a commit, or into a chat message. If a
# value is ever echoed into a transcript, treat it as disclosed and rotate it.

# --- inference (at least one) ---------------------------------------------------------------
# The provider that serves the model named in this profile's config.
DEEPSEEK_API_KEY=
# Alternative providers; only the ones you actually route to.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- source control -------------------------------------------------------------------------
# A token the worker can push with. Scope it to the repos this project owns, and prefer a
# fine-grained token over a classic one.
GH_TOKEN=
# The account the token belongs to, so a push is never ambiguous about identity.
GITHUB_USER=

# --- secret manager (optional) --------------------------------------------------------------
# If you use Bitwarden Secrets Manager, the CLI reads BWS_ACCESS_TOKEN (NOT ..._ACCESS_KEY) and
# needs a machine account granted to the project; without the grant `secret list` returns an empty
# list with exit 0, which looks like an empty project rather than a permissions problem.
BWS_ACCESS_TOKEN=
BWS_PROJECT_ID=
